{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller drawing styles",
  "type": "object",
  "required": ["description", "default", "outline_width", "glyph_size", "styles"],
  "additionalProperties": false,
  "properties": {
    "description": {"type": "string"},
    "default": {"type": "string"},
    "outline_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
    "glyph_size": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["eye_candy", "dark", "light", "original"]},
          "label": {"type": "string", "minLength": 1},
          "body": {"type": "string", "pattern": "^(#[0-9a-f]{6}|[a-z_]+)$"},
          "details": {"type": "string", "pattern": "^(#[0-9a-f]{6}|[a-z_]+)$"}
        },
        "dependentRequired": {"body": ["details"], "details": ["body"]}
      }
    }
  }
}
